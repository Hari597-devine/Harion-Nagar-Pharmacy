PORT=3000
NODE_ENV=production
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
CORS_ORIGIN=*

# SMTP Email Configuration (Optional - for sending password reset verification OTP emails)
# If omitted or empty, the system generates secure OTPs and displays/logs them safely.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="Harion Nagar Hospital & Pharmacy" <no-reply@harionnagarpharmacy.com>


